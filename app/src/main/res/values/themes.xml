<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every colour comes from values/colors.xml, so a palette is one file. -->
    <style name="Theme.ChineseChess" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/chess_accent</item>
        <item name="colorPrimaryDark">@color/chess_bg</item>
        <item name="colorAccent">@color/chess_accent</item>
        <item name="colorSecondary">@color/chess_accent</item>
        <item name="colorOnPrimary">@color/chess_on_accent</item>
        <item name="colorSurface">@color/chess_panel</item>
        <item name="colorOnSurface">@color/chess_text</item>
        <item name="android:textColorPrimary">@color/chess_text</item>
        <item name="android:textColorSecondary">@color/chess_text_secondary</item>
        <!-- Padding for the system bar insets is applied to android.R.id.content, whose
             background is the window background, so the table is drawn there, whole, and the
             layout itself stays transparent; otherwise the status bar strip shows a seam. -->
        <item name="android:windowBackground">@drawable/chess_table_background</item>
        <item name="android:alertDialogTheme">@style/ChessDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/ChessDialogTheme</item>
        <item name="alertDialogTheme">@style/ChessDialogTheme</item>
        <item name="snackbarStyle">@style/ChessSnackbar</item>
        <item name="snackbarTextViewStyle">@style/ChessSnackbarText</item>
    </style>

    <style name="ChessDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:textColor">@color/chess_text</item>
        <item name="android:textColorPrimary">@color/chess_text</item>
        <item name="android:textColorSecondary">@color/chess_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/chess_text</item>
        <!-- AppCompat's list rows read this one, not the framework attribute above; without
             it the item names in the level and endgame lists came out near-black. -->
        <item name="textColorAlertDialogListItem">@color/chess_text</item>
        <item name="colorOnSurface">@color/chess_text</item>
        <item name="colorSurface">@color/chess_dialog_bg</item>
        <item name="colorAccent">@color/chess_accent</item>
        <item name="colorPrimary">@color/chess_accent</item>
        <item name="android:windowTitleStyle">@style/ChessDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/ChessDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ChessDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ChessDialogButton</item>
    </style>

    <style name="ChessDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/chess_dialog_title</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="ChessDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/chess_accent</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Each side's clock, at the inner end of its card's name row. -->
    <style name="SideClock">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- The serif of the names. Its figures are all one width (tnum asks for that in a font
             where they are not), so the time does not shift as it runs. -->
        <item name="android:fontFamily">serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:maxLines">1</item>
        <item name="android:text">00:00</item>
        <item name="android:textColor">@color/side_clock_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Bottom bar: icon over label, flat tonal ground. -->
    <style name="Widget.Chess.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/chess_button_bg</item>
        <item name="strokeColor">@color/chess_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/chess_button_text</item>
        <item name="rippleColor">@color/chess_button_ripple</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="iconGravity">top</item>
        <item name="iconTint">@color/chess_button_text</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="ChessSnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/chess_text</item>
    </style>

    <style name="ChessSnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/chess_bg</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">16sp</item>
    </style>
    <!-- Tappable labels for the replay bar under the board. Plain text views rather than
         buttons: a button's own padding and insets left no room in the 44dp strip, so the
         labels wrapped onto a second line and lost their lower half. One line, shrinking
         rather than cutting if a large font setting leaves too little width. -->
    <style name="Widget.Chess.ReplayButton" parent="">
        <item name="android:textColor">@color/chess_accent</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">9sp</item>
        <item name="autoSizeMaxTextSize">14sp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
