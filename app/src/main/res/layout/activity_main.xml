<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/screenTitle"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:fontFamily="@font/jade_chess_kai"
        android:text="@string/jade_game_title"
        android:textColor="@color/chess_text"
        android:textSize="26sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header: one card per side with its role, its clock and the pieces it has taken; the round
         and mode between them. The side to move gets the accent stroke, a dot and the running clock,
         so the header carries the turn on its own. Each clock sits at the inner end of its name row,
         beside the round; the role gives way to it on a narrow card. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screenTitle">

        <LinearLayout
            android:id="@+id/redCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/redTurnDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/turn_dot_red" />

                <TextView
                    android:id="@+id/redNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/red_side"
                    android:textColor="@color/chess_red_side"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/redRoleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:text="@string/role_player"
                    android:textColor="@color/chess_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/redClockText"
                    style="@style/SideClock"
                    android:layout_marginStart="4dp" />
            </LinearLayout>


            <!-- Captured pieces, in up to two rows so all sixteen fit (MainActivity.updateCapturedRow). -->
            <LinearLayout
                android:id="@+id/redCapturedPieces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="@dimen/captured_row_height"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/centerColumn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="88dp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/moveCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/round_label"
                android:textColor="@color/chess_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/gameModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:textColor="@color/chess_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blackCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_card"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/blackClockText"
                    style="@style/SideClock"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/blackRoleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/role_ai"
                    android:textColor="@color/chess_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/blackNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/black_side"
                    android:textColor="@color/chess_black_side"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/blackTurnDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/turn_dot_black" />
            </LinearLayout>


            <!-- Captured pieces, in up to two rows so all sixteen fit (MainActivity.updateCapturedRow). -->
            <LinearLayout
                android:id="@+id/blackCapturedPieces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="@dimen/captured_row_height"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status pill: whose move, check, result, or the AI thinking dots. -->
    <LinearLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/status_pill"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/side_to_move"
            android:textColor="@color/chess_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aiThinkingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <View
                android:id="@+id/thinkingDot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="2dp"
                android:background="@drawable/thinking_dot" />

            <View
                android:id="@+id/thinkingDot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="2dp"
                android:background="@drawable/thinking_dot" />

            <View
                android:id="@+id/thinkingDot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_margin="2dp"
                android:background="@drawable/thinking_dot" />
        </LinearLayout>
    </LinearLayout>

    <!-- Engine evaluation: red's share from the left, black's from the right, and the one
         number for it at the end of the bar. -->
    <LinearLayout
        android:id="@+id/evalRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusContainer">

        <com.yingwang.chinesechess.ui.EvalBarView
            android:id="@+id/evalBar"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/evalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="serif"
            android:minWidth="56dp"
            android:gravity="end"
            android:text="@string/eval_even"
            android:textColor="@color/chess_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- The board is constrained to the buttons with a 56dp reserve for the one-line strip
         under it, so it keeps its full width on tall phones and yields only on short ones.
         9:10.6 leaves room above and below the grid for the file numbers. -->
    <com.yingwang.chinesechess.ui.BoardView
        android:id="@+id/boardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="56dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonContainer"
        app:layout_constraintDimensionRatio="9:10.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/evalRow"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Under the board: the latest round of the move list (tap for the whole game), or the
         replay controls while stepping through a finished game. -->
    <FrameLayout
        android:id="@+id/belowBoard"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/boardView">

        <LinearLayout
            android:id="@+id/moveStrip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/info_panel_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/moveHistoryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="@string/history_empty"
                android:textColor="@color/chess_history_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/moveHistoryMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="serif"
                android:text="@string/history_all"
                android:textColor="@color/chess_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/replayBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/info_panel_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/replayStartButton"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/replay_start" />

            <TextView
                android:id="@+id/replayPrevButton"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/replay_prev" />

            <TextView
                android:id="@+id/replayProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:minWidth="56dp"
                android:gravity="center"
                android:textColor="@color/chess_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/replayNextButton"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="@string/replay_next" />

            <TextView
                android:id="@+id/replayEndButton"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/replay_end" />

            <TextView
                android:id="@+id/replayExitButton"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/replay_exit_short" />
        </LinearLayout>
    </FrameLayout>

    <!-- The review: what happened at the position on the board, and the graph of the whole
         game to scrub through. Shown only while replaying an analysed game; the board then
         reserves room for it. -->
    <LinearLayout
        android:id="@+id/reviewPanel"
        android:layout_width="0dp"
        android:layout_height="@dimen/review_panel_height"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/info_panel_background"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/belowBoard">

        <!-- Step straight between the moves marked on the graph. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reviewPrevMistake"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/review_prev_mistake" />

            <TextView
                android:id="@+id/reviewNextMistake"
                style="@style/Widget.Chess.ReplayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/review_next_mistake" />
        </LinearLayout>

        <TextView
            android:id="@+id/reviewInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="3"
            android:textColor="@color/chess_history_text"
            android:textSize="13sp" />

        <com.yingwang.chinesechess.ui.EvalGraphView
            android:id="@+id/reviewGraph"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- New game lives in 更多: it ends the game on the board, so it is not a tap away. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/hintButton"
            style="@style/Widget.Chess.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/hint"
            app:icon="@drawable/ic_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/undoButton"
            style="@style/Widget.Chess.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="@string/undo"
            app:icon="@drawable/ic_undo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/moreButton"
            style="@style/Widget.Chess.Button"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="@string/more"
            app:icon="@drawable/ic_more" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
